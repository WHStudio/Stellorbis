<?xml version="1.0" encoding="utf-8"?>
<!-- 图标卡内的图标着色（靠 duplicateParentState 继承父卡状态） -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false" android:color="@color/text_disabled" />
    <item android:state_selected="true" android:color="@color/primary" />
    <item android:color="@color/text_secondary" />
</selector>
