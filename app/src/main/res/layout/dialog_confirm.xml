<?xml version="1.0" encoding="utf-8"?>
<!-- 危险操作二次确认弹窗（切换编码协议会令耳机重启） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/dialog_bg"
    android:orientation="vertical"
    android:padding="@dimen/space_5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="@dimen/icon_size"
            android:layout_height="@dimen/icon_size"
            android:contentDescription="@null"
            android:src="@drawable/ic_alert"
            android:tint="@color/warning" />

        <TextView
            android:id="@+id/tv_confirm_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_2"
            android:layout_weight="1"
            android:textSize="@dimen/text_title"
            android:textStyle="bold"
            android:textColor="@color/text_primary" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_confirm_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_3"
        android:lineSpacingMultiplier="1.2"
        android:textSize="@dimen/text_caption"
        android:textColor="@color/text_secondary" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_5"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_confirm_cancel"
            style="@style/SecondaryButton"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/button_height_small"
            android:minWidth="88dp"
            android:paddingStart="@dimen/space_4"
            android:paddingEnd="@dimen/space_4" />

        <Button
            android:id="@+id/btn_confirm_ok"
            style="@style/PrimaryButton"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/button_height_small"
            android:layout_marginStart="@dimen/space_2"
            android:minWidth="88dp"
            android:paddingStart="@dimen/space_4"
            android:paddingEnd="@dimen/space_4" />
    </LinearLayout>
</LinearLayout>
