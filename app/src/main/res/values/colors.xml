<?xml version="1.0" encoding="utf-8"?>
<!--
  Stellorbis 设计令牌 — 颜色（浅色基准）
  深色覆盖见 values-night/colors.xml。
  规则：中性色承担文字与层级；primary 只表示「可交互 / 当前选中」；
        语义色只表示状态。禁止用 primary 当区块标题色。
-->
<resources>

    <!-- ==================== 品牌与交互 ==================== -->
    <!-- 主色：用于图标、选中态描边、蓝色文本（仅 >=18sp 或加粗） -->
    <color name="primary">#FF1A73E8</color>
    <color name="primary_pressed">#FF1557B0</color>
    <!-- 浅色选中底 -->
    <color name="primary_container">#FFE8F0FE</color>
    <color name="primary_container_pressed">#FFD6E4FD</color>
    <!-- 浅色选中底之上的文字/图标 -->
    <color name="on_primary_container">#FF1557B0</color>
    <!-- 白底上的蓝色正文（#1A73E8 在白色上仅约 4.3:1，不达 AA 正文阈值） -->
    <color name="primary_text">#FF1557B0</color>
    <!-- 填充式选中背景（分段控件选中段、主按钮） -->
    <color name="accent_fill">#FF1A73E8</color>
    <color name="on_accent_fill">#FFFFFFFF</color>

    <!-- ==================== 文本与分隔 ==================== -->
    <color name="text_primary">#FF1F2328</color>
    <color name="text_secondary">#FF5A6472</color>
    <color name="text_tertiary">#FF8A93A0</color>
    <color name="text_disabled">#FFA8B0BB</color>
    <color name="divider">#FFEDF0F4</color>

    <!-- ==================== 背景与容器 ==================== -->
    <color name="bg">#FFF4F6F9</color>
    <color name="surface">#FFFFFFFF</color>
    <color name="surface_variant">#FFF7F9FC</color>
    <color name="outline">#FFDFE4EA</color>
    <color name="control_outline">#FFE6EAF0</color>
    <color name="selected_outline">#FF1A73E8</color>

    <!-- ==================== 语义 ==================== -->
    <color name="success">#FF12A150</color>
    <color name="warning">#FFC77700</color>
    <color name="danger">#FFD93025</color>

    <!-- 警示条容器 -->
    <color name="banner_bg">#FFFDF3E2</color>
    <color name="banner_stroke">#FFEFD9AE</color>

    <!-- 禁用态填充 -->
    <color name="btn_disabled_bg">#FFEDF0F4</color>

    <!-- 自绘开关（ui/SwitchView）的关闭态轨道色 -->
    <color name="switch_track_off">#FFB9C1CB</color>

    <!--
      卡片描边：浅色下完全透明（层次由 elevation 阴影提供），
      深色下由 values-night 改成实色发丝线（深色下阴影不可见）。
    -->
    <color name="card_stroke">#00000000</color>

    <color name="transparent">#00000000</color>
</resources>
